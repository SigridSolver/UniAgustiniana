    </filter>
  </defs>

  <!-- Document Paper Background -->
  <rect x="15" y="15" width="970" height="1270" rx="12" fill="url(#bgGrad)" stroke="#cbd5e1" stroke-width="2" filter="url(#shadow)"/>
  
  <!-- Outer Border Frame -->
